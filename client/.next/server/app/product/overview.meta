{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/product/layout,_N_T_/product/overview/layout,_N_T_/product/overview/page,_N_T_/product/overview"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/product/overview/__PAGE__",
    "/product/overview",
    "/product",
    "/_index",
    "/_head"
  ]
}